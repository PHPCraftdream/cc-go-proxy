## ccgp config (Ktav 0.8). Created by ccgp on first run; edit freely.
## ccgp only reads this file, with one exception: the block between the
## `ccgp:managed-models` marker lines of a profile is rewritten by
## `ccgp models apply` (and after `ccgp login codex`). Everything else,
## including your comments, is never touched.
## Machine-managed state (profile URL tokens, API keys, rotating OAuth tokens)
## lives next to it in the `creds` directory (see `ccgp status`).
##
## Location:
##   Windows: %APPDATA%\cc-go-proxy\config.ktav
##   Linux:   ~/.config/cc-go-proxy/config.ktav
## Override with CCGP_CONFIG. HOST / PORT env vars win over `listen`.

listen.host: 127.0.0.1
listen.port: 60093
## Largest request body in MiB. A long conversation is resent in full on every
## call (reasoning signatures alone reach megabytes); bigger bodies are refused
## with 413. Needs a server restart (`ccgp stop`) to change.
listen.max_body_mb: 256

providers: [
    ## "codex": your ChatGPT subscription via OAuth (`ccgp login codex`, or `--device` for device code).
    {
        name: codex
        type: codex
    }
    ## "codex_api": an OpenAI-compatible API with an API key (pay per token; OpenRouter,
    ## Ollama etc. work via base_url). The key is prompted on first use and stored in
    ## creds, or read from the env var named by api_key_env.
    {
        name: codex_api
        type: codex_api
        base_url: https://api.openai.com/v1
    }
    ## "zai": z.ai GLM models through their Anthropic-compatible endpoint, requests are
    ## forwarded unconverted. API key from z.ai: `ccgp login zai`.
    {
        name: zai
        type: anthropic_compat
        base_url: https://api.z.ai/api/anthropic
        ## z.ai knows only three effort levels; Claude Code's five are converted:
        ## low -> low, medium -> high, high / xhigh / max -> max.
        effort_map: {
            low: low
            medium: high
            high: max
            xhigh: max
            max: max
        }
    }
]

## `ccgp <profile> [claude args]` runs Claude Code through a profile.
## Each profile gets its own URL token (generated, stored in creds).
##
## models: rules checked in order, first glob match wins (case-insensitive).
## Every rule states the backend model and that model's context window in
## tokens. Claude Code accepts one window per process, so ccgp tells it to
## compact before the window of the rule that serves the session's main model
## (--model, ANTHROPIC_MODEL or settings.json "model"; default sonnet). A
## profile-level `context_window: N` overrides that; `compact_percent: 70`
## compacts earlier. The last rule `match: *` catches every other model name.
profiles: [
    {
        name: codex
        provider: codex
        ## Fable -> astra, Opus -> sol, Sonnet -> luna, Haiku -> previous luna.
        ## Run `ccgp models apply codex` to refresh these to the newest releases.
        ## ccgp:managed-models begin codex
        models: [
            {
                match: *fable*
                model: gpt-6-astra
                context_window: 872000
            }
            {
                match: *opus*
                model: gpt-6-sol
                context_window: 872000
            }
            {
                match: *sonnet*
                model: gpt-6-luna
                context_window: 872000
            }
            {
                match: *haiku*
                model: gpt-5.6-luna
                context_window: 272000
            }
            {
                match: *
                model: gpt-6-luna
                context_window: 872000
            }
        ]
        ## ccgp:managed-models end codex
    }
    {
        name: codex_api
        provider: codex_api
        ## Check the model names and context windows against your API account.
        models: [
            {
                match: *
                model: gpt-5-mini
                context_window: 400000
            }
        ]
    }
    {
        name: zai
        provider: zai
        ## Fable -> glm-5.3, Opus and everything below -> glm-5.3-flash (1M windows).
        ## Run `ccgp models apply zai` to refresh these from the built-in preset.
        ## ccgp:managed-models begin zai
        models: [
            {
                match: *fable*
                model: glm-5.3
                context_window: 1000000
            }
            {
                match: *opus*
                model: glm-5.3-flash
                context_window: 1000000
            }
            {
                match: *sonnet*
                model: glm-5.3-flash
                context_window: 1000000
            }
            {
                match: *haiku*
                model: glm-5.3-flash
                context_window: 1000000
            }
            {
                match: *
                model: glm-5.3-flash
                context_window: 1000000
            }
        ]
        ## ccgp:managed-models end zai
    }
]
